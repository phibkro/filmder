{
  "name": "moviedb-interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000 CLOUDFLARE_API_TOKEN=local ALCHEMY_STAGE=development alchemy dev",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "plan": "ALCHEMY_STAGE=production alchemy plan",
    "deploy": "ALCHEMY_STAGE=production alchemy deploy",
    "infra:typecheck": "tsc --noEmit -p tsconfig.alchemy.json",
    "check": "bun run lint && bun run build && bun run infra:typecheck && bun run test",
    "prettier-watch": "onchange \"**/*\" -- prettier --write --ignore-unknown {{changed}}"
  },
  "dependencies": {
    "@sentry/react": "^10.52.0",
    "@tanstack/react-query": "^4.33.0",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260704.1",
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node": "4.0.2",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^0.34.4",
    "alchemy": "2.0.0-beta.81",
    "effect": "4.0.2",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^22.1.0",
    "prettier": "3.9.9",
    "typescript": "^5.0.2",
    "vite": "^6.4.2",
    "vitest": "^0.34.6"
  },
  "packageManager": "bun@1.3.13"
}
